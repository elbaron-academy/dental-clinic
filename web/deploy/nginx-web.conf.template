# Web/PWA locations for __DOMAIN__ (installed by web/deploy/deploy.sh).
# /api/, /admin/ and /static/ come from backend.conf in the same folder.

root __APP_DIR__/current;
index index.html;

# The service worker and manifest must always be revalidated, or installed
# PWAs keep running an old version.
location = /sw.js {
    include /etc/nginx/__NAME__/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
}

location = /manifest.webmanifest {
    include /etc/nginx/__NAME__/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    types { application/manifest+json webmanifest; }
    try_files $uri =404;
}

# Vite puts content-hashed bundles here: cache them for a year.
location /assets/ {
    include /etc/nginx/__NAME__/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    access_log off;
    try_files $uri =404;
}

# Everything else is the single-page app: unknown paths get index.html.
location / {
    include /etc/nginx/__NAME__/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
}
