# Copy to .env (or export) for local development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset for SQLite (backend/db.sqlite3). PostgreSQL example:
# DATABASE_URL=postgres://dental:dental@localhost:5432/dental_clinic
DJANGO_TIME_ZONE=UTC
# Only needed when a browser client is served from another origin:
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# DJANGO_CSRF_TRUSTED_ORIGINS=https://clinic.example.com
LOGIN_THROTTLE_RATE=10/min
