# Django locations for __DOMAIN__ (installed by backend/deploy/deploy.sh).

# Static files collected by Django (admin, DRF). Names are hashed by the manifest storage.
location /static/ {
    alias __APP_DIR__/current/staticfiles/;
    expires 30d;
    access_log off;
}

location ~ ^/(api|admin)(/|$) {
    proxy_pass http://127.0.0.1:__PORT__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Overwrite (not append) so clients cannot spoof their IP past the login throttle.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
    proxy_read_timeout 60s;
}
