# Backend settings for __DOMAIN__ (created by backend/deploy/deploy.sh, kept across releases).
# Loaded by systemd (EnvironmentFile) and by the deploy script: plain KEY=value, no quotes.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=__SECRET__
DJANGO_ALLOWED_HOSTS=__DOMAIN__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__DOMAIN__
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# PostgreSQL (see DEPLOY_TODO.md). Replace CHANGE_ME with the database password.
DATABASE_URL=postgres://dental:CHANGE_ME@127.0.0.1:5432/dental_clinic

LOGIN_THROTTLE_RATE=10/min

# Only when the PWA is served from a different domain than the API:
# CORS_ALLOWED_ORIGINS=https://app.example.com

# gunicorn (see backend/deploy/gunicorn.conf.py)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
